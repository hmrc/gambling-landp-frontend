# microservice specific routes

->         /hmrc-frontend                                             hmrcfrontend.Routes

GET        /:regime/:regNumber/current                                controllers.StatementRedirectController.onPageLoad(regime: String, regNumber: String)

GET        /                                                          controllers.StatementController.onPageLoad()

GET        /returns                                                   controllers.ReturnsSubmittedController.onPageLoad(pageSize: Int ?= 10, pageNo: Int ?= 1)

GET        /penalties                                                 controllers.PenaltiesController.onPageLoad(pageSize: Int ?= 10, pageNo: Int ?= 1)

GET        /reallocations                                             controllers.ReallocationsController.onPageLoad()
GET        /reallocations-in                                          controllers.ReallocationsInController.onPageLoad(pageSize: Int ?= 10, pageNo: Int ?= 1)
GET        /reallocations-out                                         controllers.ReallocationsOutController.onPageLoad(pageSize: Int ?= 10, pageNo: Int ?= 1)

GET        /repayments/actual-repayments                              controllers.ActualRepaymentsController.onPageLoad(pageSize: Int ?= 10, pageNo: Int ?= 1)

GET        /repayments/repayment-interest-repaid                      controllers.RepaymentInterestRepaidController.onPageLoad(pageSize: Int ?= 10, pageNo: Int ?= 1)

GET        /other-assessments                                         controllers.OtherAssessmentsController.onPageLoad(pageSize: Int ?= 10, pageNo: Int ?= 1)

GET        /assessments                                               controllers.AssessmentInAbsenceOfReturnsController.onPageLoad(pageSize: Int ?= 10, pageNo: Int ?= 1)

GET        /interest-breakdown                                        controllers.InterestBreakdownController.onPageLoad()
GET        /interest-breakdown/interest                               controllers.InterestDetailsController.onPageLoad(pageSize: Int ?= 10, pageNo: Int ?= 1)
GET        /interest-breakdown/repayment-interest                     controllers.RepaymentInterestDetailsController.onPageLoad(pageSize: Int ?= 10, pageNo: Int ?= 1)
GET        /interest-breakdown/interest-accruing/details/:interestId  controllers.InterestAccruingDrilldownController.onPageLoad(interestId: String, pageSize: Int ?= 10, pageNo: Int ?= 1)
GET        /interest-breakdown/interest/details/:interestId           controllers.InterestDrilldownController.onPageLoad(interestId: String, pageSize: Int ?= 10, pageNo: Int ?= 1)
GET        /interest-breakdown/interest-accruing                      controllers.InterestAccruingDetailsController.onPageLoad(pageSize: Int ?= 10, pageNo: Int ?= 1)

GET        /payments                                                  controllers.PaymentsController.onPageLoad(pageSize: Int ?= 10, pageNo: Int ?= 1)

GET        /repayments                                                controllers.RepaymentsController.onPageLoad()
GET        /actual-repayments                                         controllers.ActualRepaymentsController.onPageLoad(pageSize: Int ?= 10, pageNo: Int ?= 1)

GET        /assets/*file                                              controllers.Assets.versioned(path="/public", file: Asset)

GET        /language/:lang                                            controllers.LanguageSwitchController.switchToLanguage(lang: String)

GET        /refresh-session                                           controllers.KeepAliveController.keepAlive()

GET        /there-is-a-problem                                        controllers.JourneyRecoveryController.onPageLoad(continueUrl: Option[RedirectUrl] ?= None)

GET        /check-your-answers                                        controllers.CheckYourAnswersController.onPageLoad()

GET        /account/sign-out-survey                                   controllers.auth.AuthController.signOut()
GET        /account/sign-out                                          controllers.auth.AuthController.signOutNoSurvey()
GET        /account/signed-out                                        controllers.auth.SignedOutController.onPageLoad()

GET        /unauthorised                                              controllers.UnauthorisedController.onPageLoad()

GET        /there-is-a-problem-with-the-service                       controllers.SystemErrorController.onPageLoad()

GET        /there-is-a-problem-access-denied                          controllers.AccessDeniedController.onPageLoad()
GET        /page-not-found                                            controllers.PageNotFoundController.onPageLoad()
